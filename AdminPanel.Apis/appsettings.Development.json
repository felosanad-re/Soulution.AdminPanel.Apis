{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowHosts": "*",
  "ConnectionStrings": {
    "Default": "Server = .; Database = AdminDashboard; Trusted_Connection = True; TrustServerCertificate= True"
  },
  "JWT": {
    "audience": "MyClients",
    "issuer": "https://localhost:7133",
    "expires": 1,
    "Key": "a-string-secret-at-least-256-bits-long"
  },
  "BasePictureUrl": "https://localhost:7133",
  "FileSitteng": {
    "ProductMainImages": "Products/main",
    "ProductSubImages": "Products/Sub",
    "BrandImages": "Brands/Logos",
    "CategoryImages": "Category/Images",
    "MaxSize": 2097152,
    "Allowed_Extentions": [ ".png", ".jpg", ".jpeg" ]
  }
}
